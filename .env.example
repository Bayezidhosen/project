# StudioSpace Environment Configuration

# Server & App URL
PORT=3000
APP_URL="http://localhost:3000"

# MongoDB Atlas Connection
# If not provided, StudioSpace gracefully uses an in-memory/JSON-persisted store in dev
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/studiospace?retryWrites=true&w=majority"

# JWT Authentication Secret
JWT_SECRET="studiospace_jwt_super_secret_key_2026_production"

# Better Auth Configuration (if using standalone better-auth endpoint)
BETTER_AUTH_SECRET="studiospace_better_auth_secret_token_9934"
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth Credentials (Optional: used for real Google Sign-In)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ImgBB Image Hosting API Key (Optional)
IMGBB_API_KEY="your_imgbb_api_key"

# Gemini AI API (AI Studio runtime)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
